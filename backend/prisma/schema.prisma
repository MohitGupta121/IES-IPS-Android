generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model ATKT {
  id                      Int      @id @default(autoincrement())
  computer_code           Int
  enrollment_no           String   @db.VarChar(32)
  department_id           Int
  specialisation          Int      @default(0)
  batch_id                Int
  semester                Int
  college_subject_code    String   @db.VarChar(50)
  university_subject_code String   @db.VarChar(50)
  subject_type            String   @db.VarChar(11)
  orignal_session         Int
  current_session         Int
  earn_credit             Int
  total_credit            Int
  grade                   String?  @default("0") @db.VarChar(50)
  earn_marks              Int
  result                  String   @db.VarChar(11)
  eligible                Int
  entry_time              DateTime @default(now()) @db.Timestamp(0)
  exam_form               Int?
  form_forward            Int?
}

model academic_session {
  academic_session_id Int     @id @default(autoincrement())
  academic_session    String  @db.VarChar(32)
  active              Boolean
}

model add_atkt_result {
  id                      Int      @id @default(autoincrement())
