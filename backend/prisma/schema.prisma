  college_subject_code    String   @db.VarChar(50)
  university_subject_code String   @db.VarChar(50)
  subject_type            String   @db.VarChar(11)
  earn_credit             Int
  grade                   String   @db.VarChar(11)
  total_credit            Int
  result                  String   @db.VarChar(50)
  earn_marks              Int
  academic_session        Int
  grace_marks             Int?     @default(0)
  entry_time              DateTime @default(now()) @db.Timestamp(0)
}

